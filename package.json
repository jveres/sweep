{
	"name": "sweep-engineering",
	"private": true,
	"version": "1.0.0",
	"description": "sweep.engineering — the Sweep engineering-practices roadmap",
	"type": "module",
	"engines": {
		"node": ">=22"
	},
	"packageManager": "pnpm@11.9.0",
	"scripts": {
		"roadmaps": "node scripts/build-roadmaps.mjs",
		"dev": "pnpm run roadmaps && vite",
		"build": "pnpm run roadmaps && vite build",
		"preview": "vite preview",
		"deploy": "pnpm run build && wrangler deploy",
		"check": "biome check .",
		"check:fix": "biome check --write .",
		"format": "biome format --write .",
		"typecheck": "tsc --noEmit && tsc -p worker --noEmit"
	},
	"dependencies": {
		"svg-roadmap": "github:jveres/svg-roadmap#v0.1.1"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.13",
		"@cloudflare/vite-plugin": "^1.54.8",
		"@cloudflare/workers-types": "^5.20260911.1",
		"@types/node": "^26.5.1",
		"typescript": "^7.0.2",
		"vite": "^8.3.0",
		"wrangler": "^4.131.1"
	}
}
